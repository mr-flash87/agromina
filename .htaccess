# AgroMina – configuration Apache / LiteSpeed (Hostinger)
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Si le site est dans un sous-dossier (ex. /boutique), remplacez / par /boutique/
  RewriteBase /

  # Adresse officielle : https://agrominasn.com (SSL actif). Tout le reste y est redirigé en une seule étape (301) :
  # http://, www.agrominasn.com et l'ancien sous-domaine agromina.pixelpub.online.
  RewriteCond %{HTTP_HOST} ^(www\.)?agrominasn\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^agromina\.pixelpub\.online$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://agrominasn.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^(www\.agrominasn\.com|agromina\.pixelpub\.online)$ [NC]
  RewriteRule ^ https://agrominasn.com%{REQUEST_URI} [L,R=301]

  # Fiche produit : /produit/thiakry-mil
  RewriteRule ^produit/([A-Za-z0-9-]+)/?$ produit.php?slug=$1 [L,QSA]

  # Article du blog : /blog/le-fonio
  RewriteRule ^blog/([A-Za-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]

  # /admin -> /admin/
  RewriteRule ^admin$ admin/ [L,R=301]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Adresses sans .php : /boutique -> boutique.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# Fichiers internes jamais servis directement
<FilesMatch "(^\.|\.(sql|md|lock|log)$|^_layout\.php$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
# CSS/JS sont versionnés (?v=date) : on peut les garder longtemps en cache.
<FilesMatch "\.(css|js)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>
# Sécurité (bon signal pour Google et les navigateurs)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Application admin installable (PWA)
AddType application/manifest+json .webmanifest
<Files "sw.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </IfModule>
</Files>
